{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Signet window",
  "windows": ["main", "message-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "notification:default",
    "opener:default"
  ]
}
